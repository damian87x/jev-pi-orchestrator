    "type": "git",
    "url": "git+https://github.com/damian87x/jev-pi-orchestrator.git"
  },
  "bugs": {
    "url": "https://github.com/damian87x/jev-pi-orchestrator/issues"
  },
  "keywords": [
    "pi-package",
    "jev",
    "typesafe",
    "orchestrator",
    "subagents"
  ],
  "files": [
    "extensions/",
    "agents/",
    "skills/",
    "core/lib/",
    "core/scripts/",
    "core/skills/",
    "core/UPSTREAM",
    "README.md",
    "LICENSE",
    ".env.example"
